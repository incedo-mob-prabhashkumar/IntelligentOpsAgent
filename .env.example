# Local model configuration
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:latest

# Azure OpenAI configuration (required only when LLM_PROVIDER=azure_openai)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=replace-with-a-secret
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=replace-with-your-model-deployment-name

# Local PostgreSQL configuration
POSTGRES_DSN=postgresql://postgres:postgres@localhost:5432/it_support

# Optional app configuration
MAX_KB_RESULTS=3
APP_NAME=AI IT Support Assistant
SHOW_TRACE=true

# Optional semantic retrieval model for knowledge search
SENTENCE_TRANSFORMER_MODEL=sentence-transformers/all-MiniLM-L6-v2
